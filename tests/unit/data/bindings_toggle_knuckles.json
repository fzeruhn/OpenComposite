{
  "controller_type": "knuckles",
  "bindings": {
    "/actions/main": {
      "sources": [
        { "path": "/user/hand/right/input/trigger", "mode": "toggle_button", "inputs": { "click": { "output": "/actions/main/in/toggle" } } },
        { "path": "/user/hand/left/input/thumbstick", "mode": "joystick", "inputs": { "position": { "output": "/actions/main/in/move3" } } }
      ],
      "poses": [{ "output": "/actions/main/in/pose", "path": "/user/hand/right/pose/raw" }],
      "haptics": [{ "output": "/actions/main/out/haptic", "path": "/user/hand/right/output/haptic" }]
    }
  }
}
