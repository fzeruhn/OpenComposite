<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OpenLamina.exe, the Windows app that installer/OpenLamina.iss installs next to the OpenLamina folder's
    bin\: switches OpenVR games between OpenLamina and SteamVR, sends single programs to either (per-app settings),
    and offers new releases of github.com/fzeruhn/OpenLamina. Built by scripts/ci/build-installer.ps1; Tests\ checks
    Core\ (dotnet test RuntimeSwitcher/Tests).

    .NET Framework 4.8, which Windows 10 (1903 and later) and 11 come with, so nothing else is installed. It builds with
    the .NET SDK anywhere, Linux too, from the reference assemblies package.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>OpenLamina</AssemblyName>
    <RootNamespace>RuntimeSwitcher</RootNamespace>
    <LangVersion>12</LangVersion>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <!-- The same bytes from any checkout folder. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>OpenLamina</Product>
    <Description>Switches OpenVR games between OpenLamina and SteamVR</Description>
    <Company>github.com/fzeruhn/OpenLamina</Company>
    <Copyright>GPL-3.0-or-later</Copyright>
    <!-- The build script passes the release's: Version (numbers only) and InformationalVersion (the release's name). -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
